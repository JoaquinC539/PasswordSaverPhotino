{
  "app-id": "com.JCOpenSoftware.PasswordSaver",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "PasswordSaver",

  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],

  "modules": [
    {
      "name": "passwordsaver",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin",
        "cp -r publish/* /app/bin/",

        "install -Dm644 flatpak/com.JCOpenSoftware.PasswordSaver.desktop /app/share/applications/com.JCOpenSoftware.PasswordSaver.desktop",
        "mkdir -p /app/share/icons/hicolor",
        "cp -r flatpak/icons/* /app/share/icons/hicolor/",
        "chmod +x /app/bin/PasswordSaver"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
